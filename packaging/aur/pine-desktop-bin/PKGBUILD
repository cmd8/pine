# Maintainer: <name> <email>  (the AUR account that submits it)
#
# The Pine desktop app as pine's release builds it: the .deb of the release, unpacked into the
# same places (/opt/Pine, /usr/share), with the link the .deb's own postinst makes.
# A new release changes pkgver and the two checksums; nothing else (see packaging/linux.md in pine's repository).

pkgname=pine-desktop-bin
_pkgname=pine-desktop
pkgver=0.62.0
pkgrel=1
pkgdesc="The desktop app for pine, an event-driven multi-agent daemon"
arch=('x86_64' 'aarch64')
url="https://github.com/pmndre/pine"
license=('MIT')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux-libs' 'libsecret' 'alsa-lib' 'dbus' 'expat' 'hicolor-icon-theme')
optdepends=('libappindicator-gtk3: tray icon on desktops that need it'
            'bubblewrap: the sandbox pine runs agents in (safe and manual modes)'
            'python-gobject: app control on X11 (with python-xlib)'
            'python-xlib: app control on X11 (with python-gobject)'
            'whisper-cpp: dictation, recognised on this computer (with a model and a recorder)'
            'libpulse: parecord, the recorder dictation uses (or alsa-utils for arecord)')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
options=('!strip' '!debug')
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/pmndre/pine/v${pkgver}/LICENSE")
source_x86_64=("Pine-${pkgver}-amd64.deb::https://github.com/pmndre/pine/releases/download/v${pkgver}/Pine-${pkgver}-amd64.deb")
source_aarch64=("Pine-${pkgver}-arm64.deb::https://github.com/pmndre/pine/releases/download/v${pkgver}/Pine-${pkgver}-arm64.deb")
noextract=("Pine-${pkgver}-amd64.deb" "Pine-${pkgver}-arm64.deb")
sha256sums=('SKIP')
sha256sums_x86_64=('2662160d5a4a7aacef094b751d369f1ae0f3b057c7fb87ab65224c06bba10ca3')
sha256sums_aarch64=('5decb7cf44d04ab3a1b586be38144f2a181efb1f72cc15a61bdd69b9f8a7b6a9')

prepare() {
	local deb
	case "${CARCH}" in
		x86_64) deb="Pine-${pkgver}-amd64.deb" ;;
		aarch64) deb="Pine-${pkgver}-arm64.deb" ;;
	esac
	mkdir -p data
	bsdtar -xOf "${deb}" data.tar.xz | bsdtar -xJf - -C data
}

package() {
	cp -a data/opt "${pkgdir}/"
	install -d "${pkgdir}/usr"
	cp -a data/usr/share "${pkgdir}/usr/"
	rm -rf "${pkgdir}/usr/share/doc"

	# Arch has unprivileged user namespaces: Chromium's setuid helper is not needed.
	chmod 0755 "${pkgdir}/opt/Pine/chrome-sandbox"
	# The AppArmor profile is Ubuntu's; Arch does not load AppArmor by default.
	rm -f "${pkgdir}/opt/Pine/resources/apparmor-profile"

	install -d "${pkgdir}/usr/bin"
	ln -s /opt/Pine/pine-desktop "${pkgdir}/usr/bin/${_pkgname}"
	install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
