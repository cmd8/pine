pkgbase = pine-desktop-bin
	pkgdesc = The desktop app for pine, an event-driven multi-agent daemon
	pkgver = 0.62.0
	pkgrel = 1
	url = https://github.com/pmndre/pine
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = gtk3
	depends = libnotify
	depends = nss
	depends = libxss
	depends = libxtst
	depends = xdg-utils
	depends = at-spi2-core
	depends = util-linux-libs
	depends = libsecret
	depends = alsa-lib
	depends = dbus
	depends = expat
	depends = hicolor-icon-theme
	optdepends = libappindicator-gtk3: tray icon on desktops that need it
	optdepends = bubblewrap: the sandbox pine runs agents in (safe and manual modes)
	optdepends = python-gobject: app control on X11 (with python-xlib)
	optdepends = python-xlib: app control on X11 (with python-gobject)
	optdepends = whisper-cpp: dictation, recognised on this computer (with a model and a recorder)
	optdepends = libpulse: parecord, the recorder dictation uses (or alsa-utils for arecord)
	provides = pine-desktop
	conflicts = pine-desktop
	noextract = Pine-0.62.0-amd64.deb
	noextract = Pine-0.62.0-arm64.deb
	options = !strip
	options = !debug
	source = LICENSE-0.62.0::https://raw.githubusercontent.com/pmndre/pine/v0.62.0/LICENSE
	sha256sums = SKIP
